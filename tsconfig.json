{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@models": ["src/models/index.ts"],
      "@models/*": ["src/models/*"],
      "@services": ["src/services/index.ts"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@theme": ["src/theme/index.ts"],
      "@context/*": ["src/context/*"],
      "@navigation/*": ["src/navigation/*"],
      "@screens/*": ["src/screens/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "App.tsx"]
}
